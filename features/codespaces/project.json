{
  "name": "zpp-codespaces-bdd",
  "root": "features/codespaces",
  "projectType": "application",
  "targets": {
    "bdd": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["bddShared", "{projectRoot}/**/*"],
      "outputs": [],
      "options": {
        "command": "uv run python scripts/run_behave_roots.py features/codespaces --format progress",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
